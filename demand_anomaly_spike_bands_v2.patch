+def _contiguous_intervals(
+    timestamps: pd.Series,
+    interval_minutes: int,
+) -> list[tuple[pd.Timestamp, pd.Timestamp]]:
+    """Merge adjacent flagged 15-minute timestamps into one visual band."""
+    values = pd.DatetimeIndex(pd.to_datetime(timestamps, utc=True, errors="coerce").dropna())
+    if len(values) == 0:
+        return []
+    values = values.sort_values().unique()
+    step = pd.Timedelta(minutes=interval_minutes)
+    starts: list[pd.Timestamp] = []
+    ends: list[pd.Timestamp] = []
+    run_start = values[0]
+    previous = values[0]
+    for current in values[1:]:
+        if current - previous != step:
+            starts.append(run_start - step / 2)
+            ends.append(previous + step / 2)
+            run_start = current
+        previous = current
+    starts.append(run_start - step / 2)
+    ends.append(previous + step / 2)
+    return list(zip(starts, ends))
+
